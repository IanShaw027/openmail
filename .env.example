# ═══════════════════════════════════════════════════════════════════
# OpenMail — copy to .env and edit before `docker compose up`
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ── Image / port (compose) ────────────────────────────────────────
# Default image is Docker Hub (see docker-compose.yml):
#   ianshaw027/openmail:v0.1.0
# OPENMAIL_IMAGE=ianshaw027/openmail:latest
# OPENMAIL_PULL_POLICY=always
# OPENMAIL_PORT=8000

# ── Required ──────────────────────────────────────────────────────
# 32-byte AES key (base64 or 64 hex). Generate:
#   ./scripts/gen-master-key.sh
OPENMAIL_MASTER_KEY=
# Previous keys after rotation (comma/newline). Decrypt-only.
# OPENMAIL_MASTER_KEY_FALLBACKS=


# SQLite on the Docker volume (four slashes = absolute path inside container)
OPENMAIL_DATABASE_URL=sqlite:////data/openmail.db

# ── Public URL / cookies ──────────────────────────────────────────
# Public origin for absolute URLs (set to your real host in production)
PUBLIC_BASE_URL=http://localhost:8000

# Same-origin SPA → leave empty. Dev split frontend only:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# Behind HTTPS reverse proxy: COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_COOKIE_NAME=openmail_session
SESSION_MAX_AGE_SECONDS=604800

# ── Fetch / sync ──────────────────────────────────────────────────
FETCH_MIN_INTERVAL_SECONDS=3
# Crash-recoverable per-account fetch lease; must exceed normal provider request duration
FETCH_LOCK_LEASE_SECONDS=180
# Public code API cache freshness; 0 always revalidates upstream
CODE_API_CACHE_TTL_SECONDS=90
FETCH_CONCURRENCY=10
FETCH_DEFAULT_LOOKBACK_DAYS=3
MAIL_RETENTION_DAYS=90

SYNC_ENABLED_GLOBAL=true
SYNC_INTERVAL_SECONDS=3600
SYNC_CONCURRENCY=10
SYNC_FOLDERS=inbox,junk

# ── Outbound proxy pool ───────────────────────────────────────────
# Multi-line SOCKS/HTTP. With `docker compose --profile warp`:
#   socks5://warp-1:1080 … socks5://warp-10:1080 (auto-set in compose)
PROXY_POOL=
# Legacy single template (only if PROXY_POOL empty)
PROXY_TEMPLATE=
# sticky_per_account | rotate_per_sync | rotate_on_error | round_robin
PROXY_SID_STRATEGY=sticky_per_account

# Optional WARP+ license for warp profile nodes
# WARP_LICENSE_KEY=

# ── Quotas & license (no user accounts) ───────────────────────────
# Client Settings → license field. Any listed token removes quotas for that browser.
LICENSE_TOKENS=openmail-license-1
LICENSE_HMAC_SECRET=
QUOTA_MAX_LOCAL_ACCOUNTS=100
QUOTA_MAX_CLOUD_ACCOUNTS=50
QUOTA_MAX_POLL_PER_HOUR=1000
