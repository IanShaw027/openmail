# ═══════════════════════════════════════════════════════════════════
# OpenMail production / Docker environment
# cp .env.example .env  &&  edit secrets before `docker compose up`
# ═══════════════════════════════════════════════════════════════════

# Required: 32-byte AES key (base64 or 64 hex chars).
# Generate:  ./scripts/gen-master-key.sh
# Or:        python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
OPENMAIL_MASTER_KEY=

# Admin console password (change before first deploy)
ADMIN_PASSWORD=change-me-admin

# SQLite on the Docker volume (four slashes = absolute path)
OPENMAIL_DATABASE_URL=sqlite:////data/openmail.db

# CORS: same-origin SPA (served by this container) → leave empty.
# Dev split-frontend only: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# Public origin used when minting absolute code-api URLs
# Set to your real host, e.g. https://mail.example.com
PUBLIC_BASE_URL=http://localhost:8000

# Cookie / session
SESSION_COOKIE_NAME=openmail_session
ADMIN_COOKIE_NAME=openmail_admin
SESSION_MAX_AGE_SECONDS=604800
# Production behind HTTPS: set COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Fetch rate floor (seconds between real upstream fetches per account)
FETCH_MIN_INTERVAL_SECONDS=3

# ── Optional: background sync ─────────────────────────────────────
SYNC_ENABLED_GLOBAL=true
SYNC_INTERVAL_SECONDS=3600
SYNC_CONCURRENCY=2
SYNC_FOLDERS=inbox,junk

# ── Outbound proxy pool (in-process; no sidecar product) ──────────
# Multi-line SOCKS/HTTP exits. With `docker compose --profile warp`:
#   socks5://warp-1:1080 … socks5://warp-10:1080 (auto-set in compose)
# Leave empty for direct egress.
PROXY_POOL=
# Legacy single template (used only if PROXY_POOL empty)
PROXY_TEMPLATE=
# sticky_per_account | rotate_per_sync | rotate_on_error | round_robin
PROXY_SID_STRATEGY=sticky_per_account
# Batch/import + suggested client concurrency
FETCH_CONCURRENCY=10
# Background sync parallelism (private accounts → MailIndex / 我的邮件)
SYNC_CONCURRENCY=10

# Optional WARP+ license for warp profile nodes
# WARP_LICENSE_KEY=


# Quotas & license (no user accounts required)
AUTH_UI_ENABLED=false
QUOTA_MAX_LOCAL_ACCOUNTS=100
QUOTA_MAX_CLOUD_ACCOUNTS=50
QUOTA_MAX_POLL_PER_HOUR=1000
# One shared token is enough: client puts it in Settings → license field.
# Any valid token removes all quotas for that browser.
LICENSE_TOKENS=openmail-license-1
LICENSE_HMAC_SECRET=
FETCH_DEFAULT_LOOKBACK_DAYS=3
MAIL_RETENTION_DAYS=90
