# Minimal local-dev subset. Full operator list: repo root `.env.example`.
# Required: 32-byte key, base64-encoded (or 64 hex chars).
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
OPENMAIL_MASTER_KEY=

# hosted (unset default) | solo (unlimited, no license UI, sync off, admission=open)
# Restart after change. First trusted unlock becomes admin if the list is empty.
OPENMAIL_INSTANCE_MODE=solo

# Device = vk_… vault id. first_trust (unset default) or open. Ignored in solo.
OPENMAIL_DEVICE_ADMISSION=open

# Recovery / override. Empty → first trusted unlock is persisted to data/admin_device_ids.
# OPENMAIL_ADMIN_DEVICE_IDS=vk_…


# SQLite database path (relative to CWD or absolute)
OPENMAIL_DATABASE_URL=sqlite:///./openmail.db

# Leave empty for same-origin SPA (Docker / production). Split Vite → API:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# Public base URL used when building code-api absolute URLs
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Engineering floor: min seconds between real upstream fetches per account
FETCH_MIN_INTERVAL_SECONDS=3
# Crash-recoverable per-account fetch lease
FETCH_LOCK_LEASE_SECONDS=180
# Public code API cache TTL; 0 disables the short-cache path
CODE_API_CACHE_TTL_SECONDS=90
# Public code API per-token abuse control; 0 = no limit. The fetch cap also
# throttles unknown-token requests, keyed by client IP.
CODE_API_MAX_FETCH_PER_HOUR=60
CODE_API_MAX_REFRESH_PER_HOUR=15
